{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$id": "user",
  "type": "object",
  "properties": {
      "id": {"type": "string"},
      "username": {"type": "string"},
      "phone": {
          "type": "string",
          "minLength": 11,
          "maxLength": 11
      },
      "password": {
          "type": "string",
          "minLength": 8,
          "errorMessage": {
              "minLength": "A senha é muito curta, o tamanho mínimo é 8 dígitos"
          }
      },
      "timestamp": {"type": "string"},
      "name": {"type": "string"},
      "email": {"type": "string"}
  },
  "required": [
      "password",
      "phone",
      "timestamp"
  ],
  "additionalProperties": false
}