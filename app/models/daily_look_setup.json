{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"$id": "daily_look_setup",
	"type": "object",
	"properties": {
		"_id": {
			"type": "string"
		},
		"user_id": {
			"type": "string"
		},
		"days_of_week": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"day_of_week": {
						"type": "string",
						"enum": [
							"domingo",
							"segunda",
							"terça",
							"quarta",
							"quinta",
							"sexta",
							"sábado"
						]
					},
					"occasions": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"occasion_id": {
									"type": "string"
								},
								"casual": {
									"type": "array",
									"items": {
										"type": "string",
										"enum": [
											"dia",
											"noite"
										]
									},
									"maxItems": 2
								},
								"social": {
									"type": "array",
									"items": {
										"type": "string",
										"enum": [
											"dia",
											"noite"
										]
									},
									"maxItems": 2
								}
							},
							"required": [
								"occasion_id",
								"casual",
								"social"
							],
							"additionalProperties": false
						}
					},
					"sort": {
						"type": "integer",
						"enum": [
							0,
							1,
							2,
							3,
							4,
							5,
							6
						]
					}
				},
				"required": [
					"day_of_week",
					"occasions",
					"sort"
				],
				"additionalProperties": false
			},
			"minItems": 7,
			"maxItems": 7
		}
	},
	"required": [
		"user_id",
		"days_of_week"
	],
	"additionalProperties": false
}