{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$id": "occasion",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "card_look_title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["rotina", "eventual"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}