{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"type": "object",
	"properties": {
		"data": {
			"type": "object"
		},
		"period": {
			"type": "string"
		},
		"occasion": {
			"type": "string"
		},
		"season": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"type": {
			"type": "string",
			"enum": [
				"casual",
				"social"
			]
		},
		"sort": {
			"type": "integer"
		},
		"repeat_count": {
			"type": "integer"
		}
	},
	"required": [
		"data",
		"period",
		"occasion",
		"season",
		"type",
		"sort",
		"repeat_count"
	],
	"additionalProperties": false
}