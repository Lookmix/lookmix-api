{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"type": "object",
	"properties": {
		"data": {
			"type": "object"
		},
		"period": {
			"type": "string",
			"enum": [
				"dia",
				"noite"
			]
		},
		"occasion": {
			"type": "string"
		},
		"season": {
			"type": "string",
			"enum": [
				"primavera",
				"verão",
				"outono",
				"inverno"
			]
		},
		"type": {
			"type": "string",
			"enum": [
				"casual",
				"social"
			]
		},
		"repeat_count": {
			"type": "integer"
		},
		"sort": {
			"type": "integer"
		}
	},
	"required": [
		"data",
		"timestamp",
		"period",
		"occasion",
		"season",
		"type",
		"repeat_count",
		"sort"
	],
	"additionalProperties": false
}