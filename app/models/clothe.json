{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$id": "clothe",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "closet": {
      "type": "string",
      "enum": ["casual", "social"]
    },
    "occasion_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "season_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "category_id",
    "closet",
    "occasion_ids",
    "season_ids",
    "image"
  ],
  "additionalProperties": false
}